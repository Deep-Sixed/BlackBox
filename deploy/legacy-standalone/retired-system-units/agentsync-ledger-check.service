[Unit]
Description=AgentSync Ledger consistency check

[Service]
User=agentsync-svc
Group=agentsync-svc
Type=oneshot
WorkingDirectory=/mnt/jarvis-data/projects/EVECOR/AgentSync
Environment=PYTHONPATH=/mnt/jarvis-data/projects/EVECOR/AgentSync/src
ExecStart=/mnt/jarvis-data/projects/EVECOR/AgentSync/.venv/bin/python -m ledger check --repo /mnt/jarvis-data/projects/EVECOR/AgentSync
