[Unit]
Description=EVECOR Recon gateway — cpex tool_post_invoke observer (port 8773)
Documentation=file:///mnt/jarvis-data/projects/EVECOR/AgentSync/src/recon/gateway.py
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
User=agentsync-svc
Group=agentsync-svc
Type=simple
WorkingDirectory=/mnt/jarvis-data/projects/EVECOR/AgentSync
Environment=RECON_GATEWAY_LOG=/mnt/jarvis-data/projects/EVECOR/AgentSync/storage/recon/observations.jsonl
ExecStart=/mnt/jarvis-data/projects/EVECOR/AgentSync/.venv/bin/uvicorn \
    recon.gateway:app \
    --host 127.0.0.1 \
    --port 8773 \
    --log-level warning
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
SyslogIdentifier=evecor-recon-gateway

[Install]
WantedBy=multi-user.target
