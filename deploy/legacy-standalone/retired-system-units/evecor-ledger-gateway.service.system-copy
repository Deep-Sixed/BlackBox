[Unit]
Description=EVECOR Ledger gateway — cpex tool_post_invoke observer (port 8774)
Documentation=file:///mnt/jarvis-data/projects/EVECOR/AgentSync/src/ledger/gateway.py
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
User=agentsync-svc
Group=agentsync-svc
Type=simple
WorkingDirectory=/mnt/jarvis-data/projects/EVECOR/AgentSync
Environment=LEDGER_REPO_ROOT=/mnt/jarvis-data/projects/EVECOR/AgentSync
ExecStart=/mnt/jarvis-data/projects/EVECOR/AgentSync/.venv/bin/uvicorn \
    ledger.gateway:app \
    --host 127.0.0.1 \
    --port 8774 \
    --log-level warning
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
SyslogIdentifier=evecor-ledger-gateway

[Install]
WantedBy=multi-user.target
