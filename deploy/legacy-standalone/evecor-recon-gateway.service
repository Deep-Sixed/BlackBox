[Unit]
Description=EVECOR Recon gateway — session flight recorder (port 8773)
Documentation=file:///mnt/jarvis-data/projects/EVECOR/governance/recon/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/mnt/jarvis-data/projects/EVECOR/governance/recon
Environment=RECON_GATEWAY_LOG=/mnt/jarvis-data/projects/EVECOR/governance/recon/storage/recon/observations.jsonl
ExecStart=/mnt/jarvis-data/projects/EVECOR/governance/recon/.venv/bin/uvicorn \
    recon.gateway:app \
    --host 127.0.0.1 \
    --port 8773 \
    --log-level warning
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
SyslogIdentifier=evecor-recon-gateway

[Install]
WantedBy=default.target
