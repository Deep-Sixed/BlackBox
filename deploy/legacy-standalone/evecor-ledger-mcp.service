[Unit]
Description=EVECOR Ledger MCP Service — explicit claim operations, direct store access (port 8586)
Documentation=file:///mnt/jarvis-data/projects/EVECOR/governance/ledger/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=agentsync-svc
Group=agentsync-svc
Type=simple
WorkingDirectory=/mnt/jarvis-data/projects/EVECOR/governance/ledger
Environment=LEDGER_MCP_TRANSPORT=http
Environment=LEDGER_MCP_PORT=8586
Environment=LEDGER_REPO_ROOT=/mnt/jarvis-data/projects/EVECOR/governance/ledger/storage/ledger
Environment=RECALL_LEDGER_STORE=/mnt/jarvis-data/projects/EVECOR/governance/ledger/storage/ledger
Environment=RECALL_RECON_STORE=/mnt/jarvis-data/projects/EVECOR/governance/recon/storage/recon
Environment=RECALL_OUTPUT_STORE=/mnt/jarvis-data/projects/EVECOR/governance/recall/storage/recall
ExecStart=/mnt/jarvis-data/projects/EVECOR/governance/ledger/.venv/bin/python -m ledger.mcp_server
Restart=always
RestartSec=10
TimeoutStopSec=30
SyslogIdentifier=evecor-ledger-mcp

[Install]
WantedBy=multi-user.target
