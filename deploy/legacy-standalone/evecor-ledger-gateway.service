[Unit]
Description=EVECOR Ledger gateway — cpex tool_post_invoke observer (port 8774)
Documentation=file:///mnt/jarvis-data/projects/EVECOR/governance/ledger/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/mnt/jarvis-data/projects/EVECOR/governance/ledger
Environment=LEDGER_GATEWAY_LOG=/mnt/jarvis-data/projects/EVECOR/governance/ledger/storage/ledger/claims.jsonl
ExecStart=/mnt/jarvis-data/projects/EVECOR/governance/ledger/.venv/bin/uvicorn \
    ledger.gateway:app \
    --host 127.0.0.1 \
    --port 8774 \
    --log-level warning
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
SyslogIdentifier=evecor-ledger-gateway

[Install]
WantedBy=default.target
