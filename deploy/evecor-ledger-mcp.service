[Unit]
Description=EVECOR Flight Recorder — Ledger MCP service (ledger_* + recall_read, port 8586)
Documentation=file:///mnt/jarvis-data/projects/EVECOR/governance/flight-recorder/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=agentsync-svc
Group=agentsync-svc
Type=simple
WorkingDirectory=/mnt/jarvis-data/projects/EVECOR/governance/flight-recorder
Environment=LEDGER_MCP_TRANSPORT=http
Environment=LEDGER_MCP_PORT=8586
Environment=FLIGHT_RECORDER_STORE=/mnt/jarvis-data/projects/EVECOR/governance/flight-recorder/storage
Environment=LEDGER_REPO_ROOT=/mnt/jarvis-data/projects/EVECOR/governance/flight-recorder/storage
Environment=RECALL_OUTPUT_STORE=/mnt/jarvis-data/projects/EVECOR/governance/flight-recorder/storage
Environment=RECALL_RECON_STORE=/mnt/jarvis-data/projects/EVECOR/governance/flight-recorder/storage
ExecStart=/mnt/jarvis-data/projects/EVECOR/governance/flight-recorder/.venv/bin/python -m ledger.mcp_server
Restart=always
RestartSec=10
TimeoutStopSec=30
SyslogIdentifier=evecor-ledger-mcp

[Install]
WantedBy=multi-user.target
