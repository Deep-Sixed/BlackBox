# Nightly verified SQLite backup of the BlackBox database (online backup API).
# Copies are 0640 in a setgid directory so the backup reader group can collect
# them; the live database stays private to blackbox-svc.
[Unit]
Description=BlackBox verified database backup
Documentation=https://github.com/Deep-Sixed/BlackBox/blob/main/docs/service.md

[Service]
Type=oneshot
User=blackbox-svc
Group=blackbox-svc
ExecStart=/opt/blackbox/current/bin/blackbox \
    --database /var/lib/blackbox/db/blackbox.sqlite3 \
    backup --to /var/backups/blackbox --keep 14 --group-readable
UMask=0027
StateDirectory=blackbox
StateDirectoryMode=0700
ReadWritePaths=/var/backups/blackbox
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
