[Unit]
Description=EVECOR Flight Recorder — Recon gateway, session capture (port 8773)
Documentation=file:///mnt/jarvis-data/projects/EVECOR/governance/flight-recorder/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/mnt/jarvis-data/projects/EVECOR/governance/flight-recorder
Environment=FLIGHT_RECORDER_STORE=/mnt/jarvis-data/projects/EVECOR/governance/flight-recorder/storage
ExecStart=/mnt/jarvis-data/projects/EVECOR/governance/flight-recorder/.venv/bin/uvicorn \
    recon.gateway:app \
    --host 127.0.0.1 \
    --port 8773 \
    --log-level warning
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
SyslogIdentifier=evecor-recon-gateway

[Install]
WantedBy=default.target
